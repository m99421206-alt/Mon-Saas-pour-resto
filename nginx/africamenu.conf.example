# AfricaMenu nginx example configuration
# Replace /var/www/africamenu with the actual path to your project root.
#
# IMPORTANT :
# - Gardez vos lignes SSL Certbot (listen 443 ssl, ssl_certificate…) si HTTPS est actif.
# - root sert /frontend/, /assets/ et index.html sans alias (plus fiable).
# - Seul /uploads/ utilise alias (dossier backend/uploads).

server {
  listen 80;
  server_name africamenu.com www.africamenu.com;

  root /var/www/africamenu;
  index index.html;

  access_log /var/log/nginx/africamenu.access.log;
  error_log /var/log/nginx/africamenu.error.log warn;

  # Nginx refuse par défaut au-delà de 1 Mo (413). L’API accepte jusqu’à 64 Mo.
  client_max_body_size 64M;

  location /api/ {
    client_max_body_size 64M;
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  location = /health {
    proxy_pass http://127.0.0.1:4000/health;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }

  location = /sitemap.xml {
    proxy_pass http://127.0.0.1:4000/sitemap.xml;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
  }

  location /uploads/ {
    alias /var/www/africamenu/backend/uploads/;
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
  }

  # Raccourcis legacy (/css/, /js/) — le HTML utilise /frontend/css/ et /frontend/js/
  location /css/ {
    alias /var/www/africamenu/frontend/css/;
    access_log off;
    expires 7d;
    add_header Cache-Control "public, max-age=604800";
  }

  location /js/ {
    alias /var/www/africamenu/frontend/js/;
    access_log off;
    expires 7d;
    add_header Cache-Control "public, max-age=604800";
  }

  location /menu/ {
    try_files $uri $uri/ /frontend/pages/mon-menu.html;
  }

  location /restaurant/ {
    try_files $uri $uri/ /frontend/pages/mon-menu.html;
  }

  location = /mon-menu.html {
    if ($arg_id) {
      return 301 /menu/$arg_id;
    }
    try_files /frontend/pages/mon-menu.html =404;
  }

  # Ancien format /<slug> → redirection canonique /restaurant/<slug>
  location ~ ^/(?!api/|uploads/|css/|js/|frontend/|assets/|restaurant/|menu/|favicon\.ico|robots\.txt|sitemap\.xml|health)([^/.]+)$ {
    return 301 /restaurant/$1;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
