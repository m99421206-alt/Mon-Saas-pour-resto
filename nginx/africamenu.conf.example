# AfricaMenu — configuration nginx (exemple production)
# Copier vers : /etc/nginx/sites-available/africamenu
# Puis : sudo ln -sf /etc/nginx/sites-available/africamenu /etc/nginx/sites-enabled/
#
# Chemins : adapter /var/www/africamenu si besoin.
#
# AVANT Certbot (tests HTTP uniquement) :
#   - Commentez le bloc « redirection HTTP → HTTPS »
#   - Dupliquez le bloc « server HTTPS » en listen 80 sans lignes ssl_*
#
# APRÈS Certbot :
#   - Gardez les deux blocs ci-dessous
#   - Vérifiez que ssl_certificate pointe vers vos fichiers Let’s Encrypt

# --- Redirection HTTP → HTTPS -------------------------------------------------
server {
  listen 80;
  listen [::]:80;
  server_name africamenu.com www.africamenu.com;

  # Laisser passer le challenge Let’s Encrypt (renouvellement Certbot)
  location ^~ /.well-known/acme-challenge/ {
    root /var/www/africamenu;
    allow all;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# --- Site principal HTTPS -----------------------------------------------------
server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name africamenu.com www.africamenu.com;

  # Certificats Let’s Encrypt (Certbot les injecte souvent automatiquement)
  ssl_certificate /etc/letsencrypt/live/africamenu.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/africamenu.com/privkey.pem;
  include /etc/letsencrypt/options-ssl-nginx.conf;
  ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

  root /var/www/africamenu;
  index index.html;

  access_log /var/log/nginx/africamenu.access.log;
  error_log /var/log/nginx/africamenu.error.log warn;

  client_max_body_size 64M;

  gzip on;
  gzip_vary on;
  gzip_min_length 256;
  gzip_comp_level 5;
  gzip_types
    text/css
    text/javascript
    application/javascript
    application/json
    image/svg+xml
    text/plain
    text/xml;

  # --- API Express (port 4000) ------------------------------------------------
  location /api/ {
    client_max_body_size 64M;
    proxy_pass http://127.0.0.1:4000;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 120s;
    proxy_send_timeout 120s;
  }

  # Santé (monitoring uptime — ne pas servir index.html)
  location = /health {
    proxy_pass http://127.0.0.1:4000/health;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    access_log off;
  }

  location = /api/health {
    proxy_pass http://127.0.0.1:4000/api/health;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    access_log off;
  }

  # Sitemap SEO (menus publics /restaurant/<slug>)
  location = /sitemap.xml {
    proxy_pass http://127.0.0.1:4000/sitemap.xml;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    expires 1h;
    add_header Cache-Control "public, max-age=3600";
  }

  # --- Fichiers statiques -----------------------------------------------------
  location /uploads/ {
    alias /var/www/africamenu/backend/uploads/;
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
  }

  location /assets/ {
    alias /var/www/africamenu/assets/;
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
  }

  # Raccourcis legacy (/css/, /js/) — le HTML utilise /frontend/css/ et /frontend/js/
  location /css/ {
    alias /var/www/africamenu/frontend/css/;
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
  }

  location /js/ {
    alias /var/www/africamenu/frontend/js/;
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
  }

  location = /frontend/pages/register.html {
    return 301 /frontend/pages/login.html;
  }

  location ^~ /frontend/ {
    access_log off;
    expires 30d;
    add_header Cache-Control "public, max-age=2592000, immutable";
    try_files $uri =404;
  }

  # Menus publics
  location /menu/ {
    try_files $uri $uri/ /frontend/pages/mon-menu.html;
  }

  location /restaurant/ {
    try_files $uri $uri/ /frontend/pages/mon-menu.html;
  }

  location = /mon-menu.html {
    if ($arg_id) {
      return 301 /menu/$arg_id;
    }
    try_files /frontend/pages/mon-menu.html =404;
  }

  # Ancien format /<slug> → redirection canonique /restaurant/<slug>
  location ~ ^/(?!api/|uploads/|css/|js/|frontend/|assets/|restaurant/|menu/|favicon\.ico|robots\.txt|sitemap\.xml|health)([^/.]+)$ {
    return 301 /restaurant/$1;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
